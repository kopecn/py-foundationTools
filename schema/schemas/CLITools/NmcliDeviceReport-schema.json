{
  "$schema": "http://json-schema.org/draft-06/schema#",
  "title": "NmcliDeviceReport",
  "description": "Per-device managed state from `nmcli device status`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows",
    "raw"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/NmcliDeviceReportRow"
      }
    },
    "raw": {
      "type": "string",
      "description": "Verbatim stdout, retained alongside rows."
    }
  },
  "definitions": {
    "NmcliDeviceReportRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "type",
        "state"
      ],
      "properties": {
        "device": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "connection": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
