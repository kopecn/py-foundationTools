{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kopecn/py_foundation_tools/schema/schemas/Robot/Geometry/RPY-schema.json",
  "title": "RPY",
  "type": "object",
  "description": "A roll/pitch/yaw rotation, with an explicit composition convention.",
  "required": ["roll", "pitch", "yaw"],
  "properties": {
    "roll": {
      "$ref": "../Units/Quantity-schema.json",
      "description": "Rotation about the roll axis."
    },
    "pitch": {
      "$ref": "../Units/Quantity-schema.json",
      "description": "Rotation about the pitch axis."
    },
    "yaw": {
      "$ref": "../Units/Quantity-schema.json",
      "description": "Rotation about the yaw axis."
    },
    "convention": {
      "type": "string",
      "enum": ["extrinsic_xyz", "intrinsic_zyx"],
      "default": "extrinsic_xyz",
      "description": "The explicit rotation-order convention roll/pitch/yaw are composed under. Required to disambiguate RPY, which has no universal convention."
    }
  },
  "additionalProperties": false
}
