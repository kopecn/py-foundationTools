# flake8 config (flake8 does not read pyproject.toml). Formatting is owned by black
# ([tool.black]); this file only lints. flake8-bugbear supplies the `B` checks.
[flake8]
max-line-length = 100

# E (pycodestyle errors), F (pyflakes), B (bugbear). The `W` warning series is
# intentionally not enforced.
select = E, F, B

# E203, W503: disabled for black compatibility.
# E704: `def f(): ...` one-liners are the idiomatic form for @overload / stub bodies
#   (e.g. cliTransact.py's typed overloads). Not a defect.
extend-ignore = E203, E704, W503

per-file-ignores =
    # Test docstrings / descriptive assertions carry long lines; don't wrap for E501.
    tests/testfoundationDataModelHelper.py: E501
    tests/test_builders.py: E501
    # sys.path bootstrap must run before the package imports → E402 is expected here.
    tests/testfoundationCLITransact.py: E402, E501

exclude =
    .git,
    __pycache__,
    build,
    dist,
    .venv,
    .venvs,
    .cleanroom-venv
